# Qdrant (vector store)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=postop_clinical_knowledge
QDRANT_TIMEOUT_SECONDS=30

# Embeddings (sentence-transformers / Hugging Face)
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
# HF_TOKEN=your_huggingface_token_here

# Chunking (ingest)
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_DOCUMENT_CHARS=200

# Retrieval (RAG)
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# LLM (Ollama — requiere `ollama serve` y `ollama pull phi3.5`)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3.5
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=512

# Agent (orchestrator / scoring)
MAX_TURNS_PER_CALL=10
ALERT_SCORE_THRESHOLD=15
YELLOW_SCORE_THRESHOLD=8
CALLS_LOG_DIR=logs/calls

# Dataset (PDFs clínicos para ingest)
TEXTOS_DIR=dataset/textos
