# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=postop_clinical_knowledge
QDRANT_TIMEOUT_SECONDS=30

# Embeddings
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_DOCUMENT_CHARS=200

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# LLM (Google Gemini 1.5 Flash)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=512

# Agent
MAX_TURNS_PER_CALL=10
ALERT_SCORE_THRESHOLD=15
YELLOW_SCORE_THRESHOLD=8
CALLS_LOG_DIR=logs/calls

# Dataset
TEXTOS_DIR=dataset/textos
