# Plantilla de variables de entorno — PostOp Voice Agent
#
# Uso habitual:
#   cp .env.example .env
#   # Edita .env: rellena las API keys y ajusta lo que necesites
#
# Los defaults viven en src/core/config.py (Settings). Este archivo se genera
# desde ahí para que no se desincronice:
#   uv run postop-config-example              # regenera .env.example (completo)
#   uv run postop-config-example --minimal    # solo secretos + Docker
#   uv run postop-config-example --show       # configuración efectiva (.env cargado)

# Referencia completa: cada línea refleja el default actual de Settings.


# Qdrant (vector store)

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=postop_clinical_knowledge
QDRANT_TIMEOUT_SECONDS=30

# Embeddings (sentence-transformers / Hugging Face)

EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# Chunking (ingest)

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_DOCUMENT_CHARS=200

# Retrieval (RAG)

RETRIEVAL_TOP_K=2
RETRIEVAL_SCORE_THRESHOLD=0.7

# LLM agent (Groq — conversación en tiempo real)

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0
GROQ_MAX_OUTPUT_TOKENS=2048

# LLM batch (Gemini — protocolos + validación de ingest)

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_JSON_MAX_ATTEMPTS=3
DOCUMENT_VALIDATION_EXCERPT_CHARS=3000

# Protocol generation (RAG + Gemini)

PROTOCOL_RETRIEVAL_TOP_K=12
PROTOCOL_RETRIEVAL_PER_QUERY_TOP_K=5
PROTOCOL_RETRIEVAL_SCORE_THRESHOLD=0.55
PROTOCOL_RETRIEVAL_EXPANDED_PER_QUERY_TOP_K=8
PROTOCOL_RETRIEVAL_EXPANDED_SCORE_THRESHOLD=0.45
PROTOCOL_MIN_SYMPTOMS=3
PROTOCOL_FRAGMENT_MAX_CHARS=1200
PROTOCOL_MAX_OUTPUT_TOKENS=8192
PROTOCOL_COMPACT_MAX_CHUNKS=6
PROTOCOL_COMPACT_FRAGMENT_MAX_CHARS=600
PROTOCOL_COMPACT_MAX_SYMPTOMS=6
PROTOCOL_SKIP_EXISTING=true
PROTOCOL_GENERATION_DELAY_SECONDS=15
PROTOCOL_DIR=storage/protocols

# Voz (Pipecat + Deepgram STT + Kokoro TTS)

DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=es
KOKORO_LANG_CODE=e
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1
VOICE_SAMPLE_RATE=24000
VOICE_PIPELINE_IDLE_TIMEOUT_SECS=300

# Agent (orchestrator / scoring)

MAX_TURNS_PER_CALL=8
RISK_FACTOR_SCORE_BONUS=2
CONVERSATION_HISTORY_MAX_TURNS=3
RAG_CONTEXT_MAX_TURNS=1
ALERT_SCORE_THRESHOLD=15
YELLOW_SCORE_THRESHOLD=8
CALLS_LOG_DIR=storage/logs/calls

# Admin API

ADMIN_TOKEN=change_me_admin_token
API_HOST=0.0.0.0
API_PORT=8000
VOICE_WEB_HOST=0.0.0.0
VOICE_WEB_PORT=7860
VOICE_WEB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VOICE_WEB_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}):\d+

# Dataset (PDFs clínicos)

TEXTOS_DIR=data/textos

# OCR (PDFs escaneados)

OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
OCR_DPI=200
OCR_MIN_CHARS=80

# === Docker Compose (variables de despliegue, no están en Settings) ===
# En contenedores, docker-compose.yml suele sobreescribir QDRANT_HOST y rutas.

# URL de voz accesible desde el navegador (build del frontend paciente)
NEXT_PUBLIC_VOICE_API_URL=http://localhost:7860
# Puerto host del frontend paciente
FRONTEND_PACIENTE_PORT=3000
# Puerto host del frontend admin
FRONTEND_ADMIN_PORT=8080
# Puerto host de Jupyter (--profile analysis)
JUPYTER_PORT=8888
