# Qdrant (vector store)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=postop_clinical_knowledge
QDRANT_TIMEOUT_SECONDS=30

# Embeddings (sentence-transformers / Hugging Face)
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
# HF_TOKEN=your_huggingface_token_here

# Chunking (ingest)
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_DOCUMENT_CHARS=200

# Retrieval (RAG)
RETRIEVAL_TOP_K=2
RETRIEVAL_SCORE_THRESHOLD=0.70

# LLM agent (Groq — conversación en tiempo real; independiente de Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_OUTPUT_TOKENS=2048

# LLM batch (Gemini — protocolos post-op + validación de ingest; independiente del agente)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_JSON_MAX_ATTEMPTS=3
DOCUMENT_VALIDATION_EXCERPT_CHARS=3000

# Protocol generation (RAG + Gemini; embeddings locales Granite)
PROTOCOL_RETRIEVAL_TOP_K=12
PROTOCOL_RETRIEVAL_PER_QUERY_TOP_K=5
PROTOCOL_RETRIEVAL_SCORE_THRESHOLD=0.55
PROTOCOL_RETRIEVAL_EXPANDED_PER_QUERY_TOP_K=8
PROTOCOL_RETRIEVAL_EXPANDED_SCORE_THRESHOLD=0.45
PROTOCOL_MIN_SYMPTOMS=3
PROTOCOL_FRAGMENT_MAX_CHARS=1200
PROTOCOL_MAX_OUTPUT_TOKENS=8192
PROTOCOL_COMPACT_MAX_CHUNKS=6
PROTOCOL_COMPACT_FRAGMENT_MAX_CHARS=600
PROTOCOL_COMPACT_MAX_SYMPTOMS=6
PROTOCOL_SKIP_EXISTING=true
PROTOCOL_GENERATION_DELAY_SECONDS=15
PROTOCOL_DIR=src/knowledge/protocol

# Voz (Pipecat + Deepgram STT + Kokoro TTS local)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=es
KOKORO_LANG_CODE=e
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.0
VOICE_SAMPLE_RATE=24000
VOICE_PIPELINE_IDLE_TIMEOUT_SECS=300

# Agent (orchestrator / scoring)
MAX_TURNS_PER_CALL=8
CONVERSATION_HISTORY_MAX_TURNS=3
RAG_CONTEXT_MAX_TURNS=1
ALERT_SCORE_THRESHOLD=15
YELLOW_SCORE_THRESHOLD=8
CALLS_LOG_DIR=storage/logs/calls

# Dataset (PDFs clínicos para ingest)
TEXTOS_DIR=dataset/textos

# OCR (PDFs escaneados — requiere Tesseract: brew install tesseract tesseract-lang)
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
OCR_DPI=200
OCR_MIN_CHARS=80

# Admin API (consola de conocimiento clínico)
ADMIN_TOKEN=change_me_admin_token
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Docker Compose — overrides para red interna y frontends
# Copia este archivo a .env y rellena las API keys antes de `docker compose up`.
# ---------------------------------------------------------------------------

# Qdrant (nombre del servicio dentro de la red Docker)
# QDRANT_HOST=qdrant-db
# QDRANT_PORT=6333

# Pipecat WebRTC — URL accesible desde el navegador del usuario (no usar hostname Docker)
VOICE_WEB_PORT=7860
NEXT_PUBLIC_VOICE_API_URL=http://localhost:7860
VOICE_WEB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Puertos expuestos en el host
FRONTEND_PACIENTE_PORT=3000
FRONTEND_ADMIN_PORT=8080
JUPYTER_PORT=8888

# Rutas dentro del contenedor (ya mapeadas en docker-compose.yml)
# TEXTOS_DIR=/app/dataset/textos
# CALLS_LOG_DIR=/app/storage/logs/calls
