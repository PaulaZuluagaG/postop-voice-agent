# Qdrant (vector store)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=postop_clinical_knowledge
QDRANT_TIMEOUT_SECONDS=30

# Embeddings (sentence-transformers / Hugging Face)
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
# HF_TOKEN=your_huggingface_token_here

# Chunking (ingest)
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_DOCUMENT_CHARS=200

# Retrieval (RAG)
RETRIEVAL_TOP_K=2
RETRIEVAL_SCORE_THRESHOLD=0.70

# LLM (Groq — Llama 3.1 70B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_OUTPUT_TOKENS=2048
DOCUMENT_VALIDATION_EXCERPT_CHARS=3000

# Agent (orchestrator / scoring)
MAX_TURNS_PER_CALL=10
ALERT_SCORE_THRESHOLD=15
YELLOW_SCORE_THRESHOLD=8
CALLS_LOG_DIR=logs/calls

# Dataset (PDFs clínicos para ingest)
TEXTOS_DIR=dataset/textos

# OCR (PDFs escaneados — requiere Tesseract: brew install tesseract tesseract-lang)
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng
OCR_DPI=200
OCR_MIN_CHARS=80

# Admin API (consola de conocimiento clínico)
ADMIN_TOKEN=change_me_admin_token
API_HOST=0.0.0.0
API_PORT=8000
